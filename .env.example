# API Keys - You need ONE of the LLM keys below
# Option 1: OpenAI (recommended if you have this)
OPENAI_API_KEY=your_openai_key_here

# Option 2: Anthropic Claude (alternative to OpenAI)
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Search API (required - has free tier with 1000 searches/month)
TAVILY_API_KEY=your_tavily_key_here

# Backend Configuration
BACKEND_HOST=localhost
BACKEND_PORT=8000

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
